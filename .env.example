# Choose "ollama" for local AI, or "gemini" for a hosted free-tier API key.
AI_PROVIDER=ollama
# Local Ollama server (no API key needed)
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Gemini API key for AI_PROVIDER=gemini. Create it at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
